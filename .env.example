# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=sauron-wallet
# local dev: use named profile; in code-server the instance role kicks in automatically
AWS_PROFILE=prospectus

# LLM: prefer Bedrock, allow fallback
LLM_PROVIDER=bedrock                        # bedrock | anthropic
# IMPORTANT: on-demand Sonnet 4 requires the cross-region inference profile ID (us. prefix),
# NOT the bare model ID from the spec.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
ANTHROPIC_API_KEY=                          # only if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Transcription: prefer Transcribe, allow Whisper fallback
TRANSCRIBE_PROVIDER=aws                     # aws | whisper

# Data providers
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=

# Brokerage (paper)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Bunq sandbox
BUNQ_API_KEY=
BUNQ_ENV=SANDBOX
BUNQ_CONF_PATH=./bunq.conf

# App
APP_PUBLIC_URL=http://localhost:3000
BACKEND_PORT=8080
FRONTEND_PORT=3000
