# Sauron Wallet / Prospectus — backend env
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.  Anything left blank
# disables the corresponding feature gracefully (the app still boots).
#
# Where to get the keys:
#   AWS:        https://console.aws.amazon.com/iam       (Bedrock + Polly + Transcribe + S3)
#               Bedrock model access for "Claude Sonnet 4" must be enabled in
#               the us-east-1 region: console → Bedrock → Model access.
#   Bunq:       https://together.bunq.com (sandbox tab)  → Generate API key
#   Alpaca:     https://app.alpaca.markets/signup        (paper trading is free)
#   NewsAPI:    https://newsapi.org/register             (free tier, 100 req/day)
#   AlphaVtg:   https://www.alphavantage.co/support/#api-key (free)
#
# All Bunq + Alpaca keys here are sandbox / paper — they cannot move real
# money. The AWS keys CAN cost real money: Bedrock Claude Sonnet 4 calls bill
# per token. Scope a dedicated IAM user with a low monthly budget alert.

# ---- AWS ------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-prospectus-bucket-name
# Pick ONE of the following two auth modes:
#   (a) Named profile from ~/.aws/credentials (recommended for local dev):
AWS_PROFILE=
#   (b) Raw access key + secret (use this on Fly.io / Render / Vercel):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- LLM (Anthropic Claude) ----------------------------------------------
LLM_PROVIDER=bedrock                                          # bedrock | anthropic
# Bedrock cross-region inference profile id — note the "us." prefix; it is
# different from the bare model id Anthropic publishes.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
ANTHROPIC_API_KEY=                                            # only when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Voice analyst --------------------------------------------------------
# Whisper runs locally (faster-whisper, ~10x faster than AWS Transcribe for
# short turns). Set to "aws" if you'd rather pay AWS Transcribe per second.
VOICE_TRANSCRIBE_PROVIDER=whisper                             # whisper | aws
WHISPER_MODEL=base.en                                         # tiny.en | base.en | small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# ---- Data providers -------------------------------------------------------
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=

# ---- Brokerage (paper trading — fake money) ------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Bunq sandbox ---------------------------------------------------------
BUNQ_API_KEY=
BUNQ_ENV=SANDBOX
BUNQ_CONF_PATH=./bunq.conf
# Per-user pots are created on demand; these only matter if you want to pin
# a specific main / pot account by id (otherwise the first account is used).
BUNQ_USER_ID=
BUNQ_MAIN_ACCOUNT_ID=
BUNQ_POT_ACCOUNT_ID=

# ---- Newsroom poller ------------------------------------------------------
NEWSROOM_POLL_INTERVAL_S=180
NEWSROOM_CACHE_MAX=400

# ---- Consumer panel (Bunq aggregated alt-data) ---------------------------
# Minimum panel size before we surface live aggregates instead of seeded
# fixtures — k-anonymity floor for a sandbox panel that doesn't have many users.
PANEL_LIVE_MIN_MATCHES=4
PANEL_LIVE_MIN_MONTHS=3

# ---- App ------------------------------------------------------------------
APP_PUBLIC_URL=http://localhost:3000
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- Auth -----------------------------------------------------------------
# 32+ random hex chars; rotate per environment. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SAURON_DB_PATH=backend/db/sauron.sqlite
