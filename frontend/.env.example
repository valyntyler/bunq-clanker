# Sauron Wallet — frontend env
# ---------------------------------------------------------------
# Copy this file to `.env.local` (Next.js convention) and adjust as needed.

# URL the browser will use to reach the FastAPI backend. For local dev this
# is http://localhost:8080; for a deployed setup, point it at your hosted
# backend (e.g. https://sauron-api.fly.dev). Variables prefixed with
# NEXT_PUBLIC_ are inlined at build time and exposed to the browser, so do
# NOT put any secrets here.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
